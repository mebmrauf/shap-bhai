# Server binding
HOST=0.0.0.0
PORT=8124

# Copy this file to .env for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit .env or paste these values into the game's code.

# Neon connection string: Neon dashboard → your project → Connect → copy the
# connection string (it starts with postgresql:// and ends with ?sslmode=require)
# Postgres — your database connection
DATABASE_URL=""
DATABASE_URL_POOLED=""

# Neon Managed Better Auth — sign-in for your app
NEON_AUTH_BASE_URL=""

# A long random secret used to anonymize player IP addresses for rate limiting.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=